+package nativebudget
+
+import (
+	"fmt"
+	"math/big"
+
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contract"
+	"github.com/ava-labs/libevm/common"
+	"github.com/ava-labs/libevm/crypto"
+)
+
+func budgetStorageKeys(owner, token, spender common.Address) (common.Hash, common.Hash) {
+	remainingKey := crypto.Keccak256Hash(
+		[]byte("nativebudget.v1.remaining"), owner[:], token[:], spender[:],
+	)
+	expiryKey := crypto.Keccak256Hash(
+		[]byte("nativebudget.v1.expiry"), owner[:], token[:], spender[:],
+	)
+	return remainingKey, expiryKey
+}
+
+func loadBudget(state contract.StateDB, owner, token, spender common.Address) (*big.Int, *big.Int) {
+	remainingKey, expiryKey := budgetStorageKeys(owner, token, spender)
+	return state.GetState(ContractAddress, remainingKey).Big(),
+		state.GetState(ContractAddress, expiryKey).Big()
+}
+
+func storeBudget(state contract.StateDB, owner, token, spender common.Address, remaining, expiry *big.Int) error {
+	if !fitsUint256(remaining) || !fitsUint256(expiry) {
+		return fmt.Errorf("remaining and expiry must fit uint256")
+	}
+
+	remainingKey, expiryKey := budgetStorageKeys(owner, token, spender)
+	state.SetState(ContractAddress, remainingKey, common.BigToHash(remaining))
+	state.SetState(ContractAddress, expiryKey, common.BigToHash(expiry))
+	return nil
+}
+
+func fitsUint256(value *big.Int) bool {
+	return value != nil && value.Sign() >= 0 && value.BitLen() <= 256
+}
