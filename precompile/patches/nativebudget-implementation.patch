@@ -0,0 +1,169 @@
+package nativebudget
+
+import (
+	"math/big"
+	"testing"
+
+	"github.com/ava-labs/avalanchego/graft/subnet-evm/precompile/contract"
+	"github.com/ava-labs/libevm/common"
+	"github.com/ava-labs/libevm/core/vm"
+	"github.com/ava-labs/libevm/libevm/stateconf"
+	"github.com/stretchr/testify/require"
+)
+
+type lifecycleStateDB struct {
+	contract.StateDB
+	slots map[common.Address]map[common.Hash]common.Hash
+}
+
+func (s *lifecycleStateDB) GetState(addr common.Address, key common.Hash, _ ...stateconf.StateDBStateOption) common.Hash {
+	return s.slots[addr][key]
+}
+
+func (s *lifecycleStateDB) SetState(addr common.Address, key, value common.Hash, _ ...stateconf.StateDBStateOption) {
+	if s.slots[addr] == nil {
+		s.slots[addr] = make(map[common.Hash]common.Hash)
+	}
+	s.slots[addr][key] = value
+}
+
+type lifecycleBlock struct {
+	contract.BlockContext
+	timestamp uint64
+}
+
+func (b lifecycleBlock) Timestamp() uint64 { return b.timestamp }
+
+type lifecycleState struct {
+	contract.AccessibleState
+	db        *lifecycleStateDB
+	timestamp uint64
+}
+
+func (s lifecycleState) GetStateDB() contract.StateDB { return s.db }
+
+func (s lifecycleState) GetBlockContext() contract.BlockContext {
+	return lifecycleBlock{timestamp: s.timestamp}
+}
+
+func TestNativeBudgetLifecycle(t *testing.T) {
+	state := lifecycleState{db: &lifecycleStateDB{
+		slots: make(map[common.Address]map[common.Hash]common.Hash),
+	}}
+	state.timestamp = 1000
+	alice := common.Address{19: 1}
+	bob := common.Address{19: 2}
+	token := common.Address{19: 3}
+	spender := common.Address{19: 4}
+
+	setInput, err := PackSetBudget(SetBudgetInput{
+		Token: token, Spender: spender, Amount: big.NewInt(100), Expiry: big.NewInt(1100),
+	})
+	require.NoError(t, err)
+
+	readInput, err := PackRemaining(RemainingInput{
+		Owner: alice, Token: token, Spender: spender,
+	})
+	require.NoError(t, err)
+
+	revokeInput, err := PackRevokeBudget(RevokeBudgetInput{
+		Token: token, Spender: spender,
+	})
+	require.NoError(t, err)
+
+	consumeInput, err := PackConsumeBudget(ConsumeBudgetInput{
+		Owner: alice, Token: token, Amount: big.NewInt(40),
+	})
+	require.NoError(t, err)
+
+	overBudgetInput, err := PackConsumeBudget(ConsumeBudgetInput{
+		Owner: alice, Token: token, Amount: big.NewInt(61),
+	})
+	require.NoError(t, err)
+
+	readAmount := func(want int64) {
+		t.Helper()
+		output, _, err := NativeBudgetPrecompile.Run(
+			state, bob, ContractAddress, readInput, RemainingGasCost, true,
+		)
+		require.NoError(t, err)
+		amount, err := UnpackRemainingOutput(output)
+		require.NoError(t, err)
+		require.Equal(t, want, amount.Int64())
+	}
+
+	readAmount(0)
+
+	_, _, err = NativeBudgetPrecompile.Run(
+		state, alice, ContractAddress, setInput, SetBudgetGasCost, false,
+	)
+	require.NoError(t, err)
+	readAmount(100)
+
+	// Bob can only revoke his own budget.
+	_, _, err = NativeBudgetPrecompile.Run(
+		state, bob, ContractAddress, revokeInput, RevokeBudgetGasCost, false,
+	)
+	require.NoError(t, err)
+	readAmount(100)
+
+	// Bob has no budget from Alice.
+	_, _, err = NativeBudgetPrecompile.Run(
+		state, bob, ContractAddress, consumeInput, ConsumeBudgetGasCost, false,
+	)
+	require.Error(t, err)
+	readAmount(100)
+
+	_, _, err = NativeBudgetPrecompile.Run(
+		state, spender, ContractAddress, consumeInput, ConsumeBudgetGasCost, false,
+	)
+	require.NoError(t, err)
+	readAmount(60)
+
+	// The spender cannot consume 61 when only 60 remain.
+	_, _, err = NativeBudgetPrecompile.Run(
+		state, spender, ContractAddress, overBudgetInput, ConsumeBudgetGasCost, false,
+	)
+	require.Error(t, err)
+	readAmount(60)
+
+	_, _, err = NativeBudgetPrecompile.Run(
+		state, alice, ContractAddress, revokeInput, RevokeBudgetGasCost, false,
+	)
+	require.NoError(t, err)
+	readAmount(0)
+
+	// Set up a fresh budget after revocation.
+	_, _, err = NativeBudgetPrecompile.Run(
+		state, alice, ContractAddress, setInput, SetBudgetGasCost, false,
+	)
+	require.NoError(t, err)
+	readAmount(100)
+
+	// One gas unit below the required cost must leave the budget intact.
+	_, gasLeft, err := NativeBudgetPrecompile.Run(
+		state, spender, ContractAddress, consumeInput, ConsumeBudgetGasCost-1, false,
+	)
+	require.ErrorIs(t, err, vm.ErrOutOfGas)
+	require.Zero(t, gasLeft)
+	readAmount(100)
+
+	// A read-only call cannot consume budget.
+	_, _, err = NativeBudgetPrecompile.Run(
+		state, spender, ContractAddress, consumeInput, ConsumeBudgetGasCost, true,
+	)
+	require.ErrorIs(t, err, vm.ErrWriteProtection)
+	readAmount(100)
+
+	// The budget is expired at its exact expiry timestamp.
+	state.timestamp = 1100
+	readAmount(0)
+	_, _, err = NativeBudgetPrecompile.Run(
+		state, spender, ContractAddress, consumeInput, ConsumeBudgetGasCost, false,
+	)
+	require.ErrorContains(t, err, "budget is unset or expired")
+
+	// Inspect storage directly: the failed call did not deduct anything.
+	amount, _ := loadBudget(state.db, alice, token, spender)
+	require.Equal(t, int64(100), amount.Int64())
+}
