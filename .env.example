# 1. Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=
DB_NAME=deficopilot_db
DB_SSLMODE=disable

# API keys are backend-only runtime secrets.
# Never put provider keys in VITE_* variables.
# For live mode, confirm model access, quota and pricing first.
# 2. AI & LLM
# Supported values: mock, openai, gemini
AI_PROVIDER=mock

# OpenAI, optional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Gemini Developer API, optional
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# 3. AVALANCHE NETWORK
# Fuji Testnet
# Supported values: mock, data_api
DATA_MODE=mock
AVALANCHE_DATA_API_KEY=
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_CHAIN_ID=43113
AVALANCHE_RPC_TIMEOUT=5s
SNOWTRACE_API_KEY=
AGENT_PRIVATE_KEY=

# 4. Frontend Web3
VITE_PRIVY_APP_ID=